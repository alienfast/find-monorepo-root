{
  // Single source of truth read by both the check-markdown script and the VS Code markdownlint extension.
  "config": {
    "default": true,
    // MD013 (line-length): we wrap prose at ~160, not 80.
    "MD013": false,
    // MD024 (no-duplicate-heading), siblings_only: repeated section names under different parents stay legal.
    "MD024": { "siblings_only": true },
    // MD041 (first-line-h1): the readme intentionally leads with status badges before the title.
    "MD041": false,
    // MD060 (table-column-style): default-on, and it ships no auto-fixer, so `--fix` can never repair it. Cosmetic; off.
    "MD060": false
  },
  "ignores": [
    "**/node_modules/**",
    "**/CHANGELOG.md",
    ".claude/worktrees/**",
    "tmp/**",
    "test/workspaces/**"
  ]
}
