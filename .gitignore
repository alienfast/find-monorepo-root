# git hands a merge driver %A as a `.merge_file_*` temp in the worktree root, and merge-jscpd-baseline.mjs stages its result beside it; a kill between write and rename leaves it behind
/.merge_file_*
# check-clones.mjs --update stages the new baseline beside it; a signal kill before the rename leaves the staged copy behind
/.jscpd-baseline.json.staged-*
